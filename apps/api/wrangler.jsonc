{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shopbooks",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The Next.js static export is served from the same Worker; /api/* always hits the Worker first.
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopbooks-db",
      // Replace with the id printed by: npx wrangler d1 create shopbooks-db
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      // Create with: npx wrangler r2 bucket create shopbooks-files
      "bucket_name": "shopbooks-files"
    }
  ],
  "vars": {
    // Comma-separated extra origins allowed to call the API with credentials (local Next.js dev server).
    "CORS_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000"
  }
}
