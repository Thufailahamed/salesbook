{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shopbooks",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The Next.js static export is served from the same Worker; /api/* always hits the Worker first.
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopbooks-db",
      "database_id": "df8ae895-450c-4993-801b-46684e724a99",
      // Local dev (wrangler dev / --local) stores D1 data under this id; it keeps the pre-production local database.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      // Create with: npx wrangler r2 bucket create shopbooks-files
      "bucket_name": "shopbooks-files"
    }
  ],
  "vars": {
    // Comma-separated extra origins allowed to call the API with credentials (local Next.js dev server).
    "CORS_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000",
    // AI Gateway used for Workers AI calls. Llama 3.2 Vision needs Meta's licence accepted once in the Cloudflare dashboard.
    "AI_GATEWAY_ID": "default",
    "AI_RECEIPT_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "AI_ASK_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_BANK_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "AI_REVIEW_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_SEARCH_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "AI_PRODUCT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_STOCK_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_REMINDER_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_HELP_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_CASHFLOW_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_SALESREVIEW_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
}
